# Local development secrets. Copy to .env and set the same keys in the Vercel project settings.

# --- Site ---
NEXT_PUBLIC_SITE_URL=https://iwhitebird.com
# Formspree form id (the part after https://formspree.io/f/)
NEXT_PUBLIC_FORMSPREE_ID=

# --- AI assistant (Groq) ---
GROQ_API_KEY=
# Optional: the in-Groq fallback model. Set to an empty string to disable the fallback.
CHAT_FALLBACK_MODEL=
# Optional: durable per-IP rate limiting across serverless instances (free tier is fine)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Notion CMS ---
# Internal integration secret; share the "Portfolio CMS" page with the integration
NOTION_TOKEN=
# The 32-char id of the parent page that holds the seven databases
NOTION_ROOT_PAGE_ID=

# --- Search Console (optional) ---
# Only needed if you verify with the meta tag instead of a DNS TXT record
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
